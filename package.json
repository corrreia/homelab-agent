{
  "name": "homelab-agent",
  "version": "0.0.1",
  "description": "One authenticated MCP endpoint fronting every service in your homelab — built on Cloudflare Code Mode.",
  "homepage": "https://github.com/corrreia/homelab-agent",
  "bugs": "https://github.com/corrreia/homelab-agent/issues",
  "license": "MIT",
  "author": "Tomás Correia",
  "repository": {
    "type": "git",
    "url": "https://github.com/corrreia/homelab-agent.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node server.entry.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@cloudflare/codemode": "^0.2.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@tanstack/react-router": "^1.120.0",
    "@tanstack/react-start": "^1.120.0",
    "better-auth": "^1.6.3",
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.45.2",
    "js-yaml": "^4.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "srvx": "^0.11.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "oxfmt",
      "oxlint --fix"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
