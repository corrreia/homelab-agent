{
  "name": "homelab-agent",
  "version": "0.0.7",
  "description": "One authenticated MCP endpoint fronting every service in your homelab — built on Cloudflare Code Mode.",
  "homepage": "https://github.com/corrreia/homelab-agent",
  "bugs": "https://github.com/corrreia/homelab-agent/issues",
  "license": "MIT",
  "author": "Tomás Correia",
  "repository": {
    "type": "git",
    "url": "https://github.com/corrreia/homelab-agent.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node server.entry.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "prepare": "husky || true",
    "test": "tsx --test test/*.test.mts",
    "update-specs": "node scripts/update-specs.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/codemode": "^0.4.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "better-auth": "^1.6.23",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "js-yaml": "^4.3.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "srvx": "^0.11.22",
    "ssh2": "^1.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.45.0",
    "oxlint": "1.60.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json}": [
      "oxfmt"
    ],
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
