# Server
PORT=3000

# Auth + at-rest credential encryption (used by Better Auth and the source-cred
# encryption layer — HKDF-derived).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# Public origin where this app is reachable (used in OAuth redirects)
AUTH_URL=http://localhost:3000

# OIDC provider (any standards-compliant issuer: Pocket ID, Authentik, Keycloak,
# Auth0, Dex, Google, Okta, …). Better Auth fetches /.well-known/openid-configuration
# from OIDC_ISSUER.
OIDC_ISSUER=https://auth.example.com
# Register a client in your provider with redirect URI:
#   ${AUTH_URL}/api/auth/oauth2/callback/oidc
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
