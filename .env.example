# Server
PORT=3000

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin where this app is reachable (used in OAuth redirects)
BETTER_AUTH_URL=http://localhost:3000

# Pocket ID (OIDC)
# Issuer URL — Better Auth fetches /.well-known/openid-configuration from here
POCKET_ID_ISSUER=https://pocket-id.example.com
# Register an OIDC client in Pocket ID admin with redirect URI:
#   ${BETTER_AUTH_URL}/api/auth/oauth2/callback/pocket-id
POCKET_ID_CLIENT_ID=
POCKET_ID_CLIENT_SECRET=

# Disables outbound TLS verification globally — DEV ONLY (TODO: replace with
# per-source allowInvalidTls).
NODE_TLS_REJECT_UNAUTHORIZED=0
